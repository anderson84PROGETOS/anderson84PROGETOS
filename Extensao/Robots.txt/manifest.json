{
  "manifest_version": 3,
  "name": "Robots.txt Explorer",
  "version": "1.0",
  "description": "Obt\u00e9m e exibe o conte\u00fado do arquivo robots.txt do site atual.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
